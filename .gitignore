# ════════════════════════════════════════════════════════════════════
#  В репозитории лежит только шаблон. Всё, что относится к вашей личной
#  установке — адреса серверов, домены, пароли, ключи — остаётся на диске
#  и в git не попадает. Так репозиторий можно форкать и присылать в него
#  правки, не рискуя случайно опубликовать свою инфраструктуру.
# ════════════════════════════════════════════════════════════════════

# ── Секреты ─────────────────────────────────────────────────────────
# Ключ от vault. Потеряете — vault не расшифровать, копию храните отдельно.
.vault-key
.vault_pass
*.vault

# Рабочие vault-файлы. В репозитории только *.example — из них их и создаёт
# make init. Даже зашифрованный AES256 vault наружу не выкладываем: публичный
# репозиторий это навсегда, а одна ошибка в настройках стоит всей инфраструктуры.
group_vars/all/vault.yaml

# SSH-ключи, включая публичный: он не секрет, но связывает репозиторий
# с вашими серверами. Создаётся командой make keygen.
keys/*
!keys/.gitkeep

# ── Ваша конфигурация ───────────────────────────────────────────────
# Список серверов с реальными адресами. Шаблон — inventory/hosts.yaml.example.
inventory/hosts.yaml

# Настройки конкретных серверов. В репозитории только каталоги example-*,
# ваши собственные (их создаёт make new-host) остаются локальными.
# Хотите версионировать свои — уберите эти строки в личном форке.
/host_vars/*
!/host_vars/example-host/
!/host_vars/example-entry/

# Артефакты, стянутые с сервера (ключи, сводки, бэкапы). Со звёздочкой и без
# слэша: artifacts/*/ ловит только каталоги, и файл, положенный в корень
# artifacts/, спокойно уехал бы в коммит.
artifacts/*
!artifacts/.gitkeep

# ── Служебное ───────────────────────────────────────────────────────
.ansible/
*.retry
.venv/
venv/
__pycache__/

trash/

# Инструкции для ИИ-ассистента: личные, в репозиторий не идут
CLAUDE.md
