---
# ════════════════════════════════════════════════════════════════════
#  ШАБЛОН списка серверов. Рабочий файл — inventory/hosts.yaml,
#  он создаётся из этого шаблона командой make init и в git не попадает.
#
#  Добавить сервер: make new-host NAME=vpn-nl IP=203.0.113.10
#  Команда создаст host_vars/vpn-nl/ и сама допишет хост сюда.
# ════════════════════════════════════════════════════════════════════
all:
  children:
    # Выходные ноды — полный стек: WireGuard, Reality, DNS-туннели, RustDesk.
    # Наружу отдают свой адрес. Это то, что нужно почти всем.
    #
    # Запись выглядит так (отступы важны):
    #         vpn-nl:
    #           ansible_host: "203.0.113.10"
    vpn:
      hosts: {}

    # Входные ноды — необязательная надстройка. Reality-вход в стране клиента,
    # трафик уходит цепочкой на выходную ноду. Нужны там, где оператор режет
    # трансграничный трафик или держит белый список. Подробности — OPERATORS.md.
    # Заводятся так: make new-host NAME=entry-local IP=... GROUP=entry
    entry:
      hosts: {}
