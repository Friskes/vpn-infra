[Unit]
Description=dnstt DNS tunnel (KCP over DNS, TCP/DoT/DoH capable)
After=network-online.target 3proxy.service
Wants=network-online.target 3proxy.service

[Service]
ExecStart={{ dnstt_bin }} \
  -udp [{{ dnstt_listen_host }}]:{{ dnstt_listen_port }} \
{% if dnstt_mtu | int > 0 %}
  -mtu {{ dnstt_mtu }} \
{% endif %}
  -privkey-file {{ dnstt_privkey }} \
  {{ dnstt_domain }} {{ dnstt_upstream }}
Restart=always
RestartSec=5

# Как и у Slipstream: демон разбирает недоверенный трафик из интернета, поэтому
# работает под своей учёткой, а из привилегий получает только право занять порт 53.
User={{ dnstt_user }}
Group={{ dnstt_user }}
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
# Соседние учётки не должны видеть чужие /proc: там оседают аргументы команд,
# которыми Ansible настраивает сервисы, вместе с паролями админок.
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
