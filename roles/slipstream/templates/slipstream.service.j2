[Unit]
Description=Slipstream DNS tunnel (QUIC over DNS)
After=network-online.target 3proxy.service
Wants=network-online.target 3proxy.service

[Service]
ExecStart={{ slipstream_bin }} \
  --dns-listen-host {{ slipstream_listen_host }} \
  --dns-listen-port {{ slipstream_listen_port }} \
  --target-address {{ proxy_host }}:{{ proxy_port }} \
  --domain {{ slipstream_domain }} \
  --cert {{ slipstream_cert }} \
  --key {{ slipstream_key }} \
  --reset-seed {{ slipstream_reset_seed }} \
  --max-connections {{ slipstream_max_connections }} \
  --idle-timeout-seconds {{ slipstream_idle_timeout }}
Restart=always
RestartSec=5

# Демон разбирает недоверенный трафик из интернета (DNS + QUIC, внутри C-код
# picoquic), поэтому работает под отдельной непривилегированной учёткой, а не root:
# ошибка в разборе пакета не даёт ни чтения чужих файлов, ни власти над системой.
# Единственная выданная привилегия — занять порт 53 (Ambient, работает и без root).
User={{ slipstream_user }}
Group={{ slipstream_user }}
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
# Соседние учётки не должны видеть чужие /proc: там оседают аргументы команд,
# которыми Ansible настраивает сервисы, вместе с паролями админок.
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths={{ slipstream_conf_dir }}
RestrictAddressFamilies=AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
