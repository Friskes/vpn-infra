#  Конфигурация 3proxy для DNS-туннеля. Файл создаётся Ansible, править вручную нет смысла.
#  Пользователи живут отдельно в {{ proxy_users_file }} и добавляются командой slipnet-user.

nserver 1.1.1.1
nserver 8.8.8.8
nscache 65536
timeouts 1 5 30 60 180 1800 15 60

# Строка на каждое соединение: дата, время, учётка, код ошибки, куда шли,
# байты туда-обратно и длительность. Без лога отказ прокси по паролю выглядит
# снаружи так же, как обрыв канала, и разобрать жалобу «не грузит» уже нечем.
# Первый символ формата (L) обязателен — это местное время, см. man 3proxy.cfg.
log {{ proxy_log_file }} D
logformat "L%d-%m-%Y %H:%M:%S %U %E %n %R:%r %I %O %D"
rotate {{ proxy_log_keep }}

# Список пользователей отдельным файлом: его переписывает slipnet-user,
# после чего 3proxy перечитывает конфиг без разрыва живых соединений.
include {{ proxy_users_file }}

# strong = без логина и пароля не пускаем вообще. Это и закрывает главную дыру:
# туннель отзывается всем, кто знает домен, но дальше прокси спросит пароль.
auth strong

{% if proxy_max_connections > 0 %}
# Потолок одновременных соединений на весь сервис, суммарно по всем учёткам.
# Лимиты на отдельного пользователя 3proxy умеет (connlim, bandlimin, countin
# принимают список учёток) — просто пока не заданы.
maxconn {{ proxy_max_connections }}
{% endif %}

# Правила читаются по порядку, первое совпадение выигрывает.
# Сначала запрещаем всё локальное и служебное: без этого пользователь туннеля
# попадает на сам сервер — в админку wg-easy и на SSH, которые слушают loopback.
# Формат: deny <кому> <откуда> <куда> <порты назначения>
deny * * {{ proxy_denied_targets | join(',') }}

# Почтовые порты закрыты для всех. Ссылку slipnet:// пересылают в мессенджерах,
# и одной утечки хватит, чтобы через сервер погнали спам: жалоба хостеру — и в
# блок-листах окажется единственный адрес, на котором держится сразу всё.
# Заодно закрыты порты SMB: их регулярно перебирают ботнеты.
deny * * * {{ proxy_denied_ports | join(',') }}

# Дальше — свободный выход в интернет.
allow * * * *

# Слушаем только localhost: снаружи порт недоступен, трафик приходит из туннеля.
socks -i{{ proxy_host }} -p{{ proxy_port }}
