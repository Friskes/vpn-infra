#!/bin/sh
# Страховка на случай опечатки в публикации порта контейнера.
#
# Docker прокидывает свои порты через DNAT в цепочке FORWARD, а ufw работает в
# INPUT — то есть правила файрвола к контейнерам не применяются вообще. Стоит
# один раз забыть префикс 127.0.0.1: в publish, и админка окажется в интернете,
# причём ufw будет показывать, что всё закрыто.
#
# ВАЖНО про область действия. Через DOCKER-USER проходит ВЕСЬ трафик докер-мостов,
# включая исходящий от контейнеров и транзит клиентов WireGuard в интернет.
# Правило DROP без привязки к интерфейсу рубит и его — проверено на живом сервере,
# VPN у всех клиентов умирает мгновенно. Поэтому фильтруем строго то, что пришло
# снаружи: -i <внешний интерфейс>. Исходящее и транзит не трогаем.
#
# ВАЖНО про порядок. Докер сам кладёт в конец цепочки свой -j RETURN, поэтому
# дописывать запрет через -A бесполезно: до него не дойдёт ни один пакет, а
# выглядеть всё будет рабочим. Вставляем через -I и в обратном порядке.
set -eu

CHAIN=DOCKER-USER
WAN="{{ docker_guard_wan_interface }}"
MARK="vpn-infra guard"

for ipt in iptables ip6tables; do
    command -v "$ipt" >/dev/null 2>&1 || continue
    "$ipt" -L "$CHAIN" -n >/dev/null 2>&1 || continue

    # -w: скрипт стартует сразу после докера, который в этот момент правит те же
    # таблицы. Без ожидания блокировки команда падает, set -e обрывает скрипт —
    # и цепочка остаётся без запрета, то есть отказ происходит в сторону «открыто».

    # Снимаем ВСЕ прежние свои правила — по метке, а не по нынешнему списку портов.
    # Иначе правило, убранное из списка (скажем, отключили сервис), останется висеть
    # в цепочке навсегда: удалять его будет уже нечему.
    # Идём с конца, чтобы номера ещё не удалённых строк не съезжали.
    for num in $("$ipt" -L "$CHAIN" -n --line-numbers | grep "$MARK" | awk '{print $1}' | sort -rn); do
        "$ipt" -w 5 -D "$CHAIN" "$num"
    done

    # Сначала запрет — он окажется последним из наших.
    "$ipt" -w 5 -I "$CHAIN" 1 -i "$WAN" -m comment --comment "$MARK" -j DROP

    # Затем порты, которые контейнерам публиковать наружу действительно можно.
    # Протокол указан явно: открывать 443/udp и 51820/tcp «на всякий случай» —
    # это две лишние двери, которыми никто не пользуется.
    for entry in {{ docker_guard_public_ports | join(' ') }}; do
        port="${entry%%/*}"
        proto="${entry##*/}"
        "$ipt" -w 5 -I "$CHAIN" 1 -i "$WAN" -p "$proto" --dport "$port" \
            -m comment --comment "$MARK" -j RETURN
    done

    # И первым — ответы на соединения, начатые изнутри.
    "$ipt" -w 5 -I "$CHAIN" 1 -i "$WAN" -m conntrack --ctstate RELATED,ESTABLISHED \
        -m comment --comment "$MARK" -j RETURN
done
