---
# ════════════════════════════════════════════════════════════════════
#  ШАБЛОН секретов ОТДЕЛЬНОГО сервера.
#  Здесь хранятся секреты конкретного сервера. SSH-пароль обязательно задавайте
#  здесь, а не в общем group_vars/all/vault.yaml.
#  Файл обязательно должен быть зашифрован: make encrypt.
# ════════════════════════════════════════════════════════════════════

# Пароль для входа по SSH именно на этот сервер.
vault_ssh_password: ""

# Пароль от веб-админки WireGuard на этом сервере.
# Разные пароли на разных серверах — правильнее: утечка одного не открывает остальные.
# Значения по умолчанию тут быть не должно: пустая строка остановит развёртывание
# с понятной ошибкой, а заглушка молча уехала бы на сервер рабочим паролем.
vault_wireguard_admin_password: ""
