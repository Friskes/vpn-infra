---
# ════════════════════════════════════════════════════════════════════
#  ШАБЛОН секретов ОТДЕЛЬНОГО сервера.
#  Здесь хранятся секреты конкретного сервера. SSH-пароль задавайте здесь,
#  а не в общем group_vars/all/vault.yaml.
#  Файл в .gitignore; make new-host шифрует его, открыть — make decrypt.
# ════════════════════════════════════════════════════════════════════

# Root-пароль этого сервера. Не нужен, если ключ вставлен при заказе или положен
# make ssh-key; иначе на компьютере нужен sshpass.
vault_ssh_password: ""

# Пароли админок (wg-easy, 3x-ui) по умолчанию общие — из group_vars/all/vault.yaml.
# Свой пароль этому серверу — раскомментировать; не короче 20 символов, иначе
# развёртывание остановится. Смена пароля wg-easy пересоздаёт его контейнер.
# vault_wireguard_admin_password: ""
# vault_xui_admin_password: ""
