---
# ════════════════════════════════════════════════════════════════════
#  ШАБЛОН настроек выходной ноды. Обычно его копирует за вас
#  make new-host NAME=... IP=... — руками сюда лезть не нужно.
#
#  Здесь только то, что отличается от сервера к серверу. Общее для всех —
#  в group_vars/all/vars.yaml, прочие ручки — в defaults ролей.
#  Всё, что ниже, необязательно: с пустым файлом развернётся WireGuard
#  и Reality, а этого хватает большинству.
# ════════════════════════════════════════════════════════════════════

# ── WireGuard ───────────────────────────────────────────────────────
# Куда подключаются клиенты. По умолчанию адрес сервера из inventory.
# Лучше задать имя: при переезде на другой сервер достаточно поменять
# A-запись, а конфиги, которые уже у людей на руках, продолжат работать.
# Слова вроде vpn и tunnel не брать — они первые в словарях перебора поддоменов.
# wireguard_host: "x.example.com"

# ── DNS-туннель Slipstream (нужен домен) ────────────────────────────
# Включается вместе с доменом. Перед развёртыванием в DNS должно быть:
#   NS-запись   t.example.com  →  ns.example.com
#   A-запись    ns.example.com →  IP этого сервера
# Один поддомен на два сервера работать не будет: резолверы получат
# два разных ответа на один вопрос. Подробности — TUNNEL.md.
# slipstream_enabled: true
# slipstream_domain: "t.example.com"

# Резолвер, который попадёт в выдаваемые ссылки. Подбирается под оператора
# и регион клиента, а не под сервер: разница доходит до пяти раз по скорости.
# Как подобрать за 10 минут — TUNNEL.md, раздел «Подбор резолвера».
# slipstream_default_resolver: "213.87.74.21"

# ── DNS-туннель dnstt (нужен домен и IPv6 у сервера) ────────────────
# Второй туннель — для операторов, которые душат поток UDP-ответов.
# Ходит к резолверу по TCP, DoT или DoH. Своя зона и свой NS:
#   AAAA-запись ns6.example.com →  IPv6 сервера
#   NS-запись   d.example.com   →  ns6.example.com
# Делегируется на IPv6 потому, что 53/udp на IPv4 занят Slipstream.
# dnstt_enabled: true
# dnstt_domain: "d.example.com"

# Некоторые резолверы объявляют буфер EDNS меньше 1232, а dnstt по умолчанию
# отвечает на такие FORMERR — и туннель не встаёт вовсе. Порог 512: ответы
# мельче и канал медленнее, зато сессия поднимается при любом настроении оператора.
# dnstt_mtu: 512

# ── Отключить или добавить сервис именно на этом сервере ────────────
# Значения перекрывают общие из group_vars/all/vars.yaml.
# rustdesk_enabled: true
# xui_enabled: false

# ── Порты ───────────────────────────────────────────────────────────
# Берутся из defaults ролей. Переопределяйте, только если на конкретном
# сервере они заняты или провайдер их режет.
# wireguard_vpn_port: 51820
# xui_public_port: 443
