---
# ════════════════════════════════════════════════════════════════════
#  ШАБЛОН входной ноды — необязательной надстройки над обычной схемой.
#  Нужна там, где оператор режет трансграничный трафик или держит белый
#  список: клиент соединяется с адресом внутри своей страны, а тот уже
#  цепочкой уводит трафик на выходную ноду за границей.
#
#  Хост кладётся в группу entry (не vpn): полного стека тут нет,
#  только вход-прокси. Прежде чем браться — прочитайте OPERATORS.md,
#  раздел «Входная нода», там про то, как выбрать проходящий адрес.
# ════════════════════════════════════════════════════════════════════

# Выходная нода, куда входная заворачивает трафик. Публичные параметры
# берутся из панели 3x-ui выходной ноды: у Reality-инбаунда есть кнопка
# показа ссылки, все значения ниже — оттуда.
xray_entry_upstream_address: "203.0.113.10"
xray_entry_upstream_port: 443
xray_entry_upstream_public_key: "<публичный ключ Reality выходной ноды>"
xray_entry_upstream_short_id: "<shortId выходной ноды>"
xray_entry_upstream_sni: "<домен прикрытия выходной ноды>"

# uuid клиента — это и есть доступ к выходной ноде, поэтому он в vault.yaml
# рядом, а не здесь. Скопируйте host_vars/example-entry/vault.yaml.example.

# Наружу открыт только порт входа: других сервисов на этой ноде нет, поэтому
# список портов задаём явно, а не через выключатели сервисов роли firewall.
firewall_allowed_tcp_ports:
  - "{{ xray_entry_port }}"
firewall_allowed_udp_ports: []

# Loopback-админок для проброса тут нет — весь -L закрыт (PermitOpen none).
ssh_permit_open: []

# Домен прикрытия самой входной ноды: сайт из белого списка оператора, реально
# живой и доступный с этой ноды. Обязателен — дефолта у него нет намеренно, чтобы
# у всех, кто развернул проект, не оказался один и тот же. Как выбрать — PROXY.md.
xray_entry_sni: ""

# ── Необязательное ──────────────────────────────────────────────────
# xray_entry_port: 8443
