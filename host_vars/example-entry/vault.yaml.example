---
# ════════════════════════════════════════════════════════════════════
#  ШАБЛОН секретов входной ноды.
#  Скопируйте в host_vars/<имя>/vault.yaml и зашифруйте: make encrypt.
# ════════════════════════════════════════════════════════════════════

# Пароль для первого входа по SSH на этот сервер. Пусто, если вход по ключу.
vault_ssh_password: ""

# uuid клиента на выходной ноде — это и есть доступ к ней. Берётся из
# ссылки vless:// в панели 3x-ui выходной ноды: часть между vless:// и @.
xray_entry_upstream_uuid: ""
